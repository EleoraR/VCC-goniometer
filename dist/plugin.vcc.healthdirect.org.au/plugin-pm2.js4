.speech-to-text-drawer-toggle:hover {
  display: flex;
  font-family: 'Material Icons';
  font-size: 28px;
  color: #1e4759;
}

.speech-to-text-drawer-toggle-active,
.speech-to-text-drawer-toggle-active:hover {
  display: flex;
  font-family: 'Material Icons';
  font-size: 28px;
  color: white;
