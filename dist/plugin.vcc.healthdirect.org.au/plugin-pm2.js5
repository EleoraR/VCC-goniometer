  .speech-to-text-drawer-toggle::after,
  .speech-to-text-drawer-toggle-active::after,
  .speech-to-text-drawer-toggle-recording::after,
  .speech-to-text-drawer-toggle-notify::after {
    content: 'closed_caption';
    padding-bottom: 0;
  }

.speech-to-text-drawer-toggle,
.speech-to-text-drawer-toggle:hover {
  display: flex;
  font-family: 'Material Icons';
  font-size: 28px;
  color: #1e4759;
}

.speech-to-text-drawer-toggle-active,
.speech-to-text-drawer-toggle-active:hover {
  display: flex;
  font-family: 'Material Icons';
  font-size: 28px;
  color: white;
  background-color: teal;
}

.speech-to-text-drawer-toggle-recording,
.speech-to-text-drawer-toggle-recording:hover,
.speech-to-text-drawer-toggle-notify,
.speech-to-text-drawer-toggle-notify:hover {
  display: flex;
  font-family: 'Material Icons';
  font-size: 28px;
  color: white;
  background-color: teal;
  border: 2px solid #dc5456;
}
