ਵ ਅਨੁਵਾਦ ਵਿੱਚ ਤੁਹਾਡਾ ਸੁਆਗਤ ਹੈ। ਸਿਹਤ ਸੇਵਾ ਪ੍ਰਦਾਤਾ ਐਪ ਤਿਆਰ ਕਰ ਰਿਹਾ ਹੈ। ਕਿਰਪਾ ਕਰਕੇ ਉਡੀਕ ਕਰੋ।"},c7={en:"Do you consent to using live translation for this session? The session may be recorded, and transcripts may be exported at the end of the session for evaluation.","zh-Hans":"您是否同意在本次会话中使用实时翻译?本次会话可能会被录制,会话结束时转录文本可能会被导出用于评估。",ar:"هل توافق على استخدام الترجمة الفورية في هذه الجلسة؟ قد يتم تسجيل الجلسة، وقد يتم تصدير النصوص المكتوبة في نهاية الجلسة لأغراض التقييم.",pa:"ਕੀ ਤੁਸੀਂ ਇਸ ਸੈਸ਼ਨ ਲਈ ਲਾਈਵ ਅਨੁਵਾਦ ਦੀ ਵਰਤੋਂ ਲਈ ਸਹਿਮਤ ਹੋ? ਸੈਸ਼ਨ ਰਿਕਾਰਡ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ, ਅਤੇ ਸੈਸ਼ਨ ਦੇ ਅੰਤ ਵਿੱਚ ਮੁਲਾਂਕਣ ਲਈ ਟ੍ਰਾਂਸਕ੍ਰਿਪਟ ਐਕਸਪੋਰਟ ਕੀਤੇ ਜਾ ਸਕਦੇ ਹਨ।"},u7={en:"Allow","zh-Hans":"允许",ar:"السماح",pa:"ਇਜਾਜ਼ਤ ਦਿਓ"},d7={en:"Deny","zh-Hans":"拒绝",ar:"رفض",pa:"ਇਨਕਾਰ ਕਰੋ"}})),Sd,Ar,f7,uC,dC,pC,h7,m7,eie=d((()=>{Sd=J(Z(),1),$n(),p7(),s7(),Ar=oe(),f7=["ar"],uC=1e4,dC=500,pC=Object.keys(Gm).filter(e=>e!=="en"),h7=e=>{try{const t=new Intl.DisplayNames([e],{type:"language"}).of(e);return t?t.charAt(0).toLocaleUpperCase(e)+t.slice(1):e}catch{return e}},m7=({displayName:e})=>{const[t,r]=(0,Sd.useState)(0),[i,s]=(0,Sd.useState)(!0),a=zU("(prefers-reduced-motion: reduce)");(0,Sd.useEffect)(()=>{const g=setTimeout(()=>s(!1),uC),y=setTimeout(()=>{r(w=>(w+1)%pC.length),s(!0)},10500);return()=>{clearTimeout(g),clearTimeout(y)}},[t]);const c=pC[t],u=f7.includes(c),f=(0,Sd.useMemo)(()=>h7(c),[c]),m=a?0:dC;return(0,Ar.jsxs)(qt,{sx:{display:"flex",flexDirection:"column",width:"100%",height:"100%"},children:[(0,Ar.jsx)(lC,{appendage:""}),(0,Ar.jsxs)(Xe,{justifyContent:"center",alignItems:"flex-start",sx:{flex:1,width:"100%",maxWidth:720,mx:"auto",px:{xs:3,sm:6},py:4,gap:{xs:3,sm:4}},children:[(0,Ar.jsxs)(qt,{children:[(0,Ar.jsxs)(mt,{component:"h1",sx:{fontWeight:700,letterSpacing:"-0.03em",lineHeight:1.05,fontSize:{xs:"2.75rem",sm:"4rem"},overflowWrap:"anywhere"},children:["Hi ",e,","]}),(0,Ar.jsx)(mt,{lang:"en",sx:{mt:1.5,maxWidth:"32ch",color:"text.secondary",fontWeight:400,lineHeight:1.35,fontSize:{xs:"1.25rem",sm:"1.5rem"